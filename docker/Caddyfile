:80 {
	encode zstd gzip


	reverse_proxy /search* atlas
	reverse_proxy /sockets/notifications* beacon
	reverse_proxy /sockets/spectator* broadcast
	reverse_proxy /leaderboards* /scores* chronicle
	reverse_proxy /downloads* content
	reverse_proxy /sockets/multiplayer* multiplayer
	reverse_proxy api # catch-all

	handle_path /assets* {
		rewrite * /buckets/fluxel{uri}
		reverse_proxy seaweedfs:8888
	}
}